<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>RugbyJunctionTrainTracker</AssemblyName>
	</PropertyGroup>

	<PropertyGroup>
		<ApplicationIcon>favicon.ico</ApplicationIcon>
	</PropertyGroup>
	
	<ItemGroup>
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="appsettings.Local.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="appsettings.Production.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Services\Services.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="favicon.ico">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <None Include="favicon.ico" />
	</ItemGroup>

	<!--
		Makes every ClickOnce release required, so the PCs install it at startup without asking. The deployment
		manifest's minimum required version is set to the version being published. This is done here rather than with
		MinimumRequiredVersion in the publish profile because Visual Studio writes a fixed version number back into the
		profile after each publish, which would leave the next release optional. It runs only when the profile sets
		UpdateRequired to True.
	-->
	<Target Name="RequireThisClickOnceVersion" BeforeTargets="GenerateDeploymentManifest" Condition="'$(UpdateRequired)' == 'true' And '$(Install)' == 'true'">
		<PropertyGroup>
			<_DeploymentBuiltMinimumRequiredVersion>$(_DeploymentManifestVersion)</_DeploymentBuiltMinimumRequiredVersion>
		</PropertyGroup>
		<Message Importance="high" Text="ClickOnce minimum required version: $(_DeploymentBuiltMinimumRequiredVersion)" />
	</Target>

</Project>
