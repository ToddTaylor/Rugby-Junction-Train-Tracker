<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>RugbyJunctionTrainTracker</AssemblyName>
	</PropertyGroup>

	<PropertyGroup>
		<ApplicationIcon>favicon.ico</ApplicationIcon>
	</PropertyGroup>
	
	<ItemGroup>
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- These two files hold the API keys and are not in git. Create each from its .example.json copy. -->
		<Content Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="appsettings.Production.json" Condition="Exists('appsettings.Production.json')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<None Include="appsettings.*.example.json" />
	</ItemGroup>

	<!--
		Stops a ClickOnce publish that would ship without the production settings, or with the placeholder keys from
		appsettings.Production.example.json. Without this check the PCs would install a release that cannot start or
		cannot reach the API.
	-->
	<Target Name="RequireProductionSettings" BeforeTargets="GenerateDeploymentManifest;_DeploymentGenerateTrustInfo" Condition="'$(PublishProtocol)' == 'ClickOnce' Or '$(Install)' == 'true'">
		<Error Condition="!Exists('appsettings.Production.json')" Text="ConsoleApp/appsettings.Production.json is missing. Copy appsettings.Production.example.json to appsettings.Production.json and fill in the API keys before publishing." />
		<PropertyGroup Condition="Exists('appsettings.Production.json')">
			<_ProductionSettingsText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/appsettings.Production.json'))</_ProductionSettingsText>
		</PropertyGroup>
		<Error Condition="$(_ProductionSettingsText.Contains('REPLACE_WITH_API_KEY'))" Text="ConsoleApp/appsettings.Production.json still has a REPLACE_WITH_API_KEY placeholder. Fill in the API keys before publishing." />
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\Services\Services.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="favicon.ico">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <None Include="favicon.ico" />
	</ItemGroup>

	<!--
		Makes every ClickOnce release required, so the PCs install it at startup without asking. The deployment
		manifest's minimum required version is set to the version being published. This is done here rather than with
		MinimumRequiredVersion in the publish profile because Visual Studio writes a fixed version number back into the
		profile after each publish, which would leave the next release optional. It runs only when the profile sets
		UpdateRequired to True.
	-->
	<Target Name="RequireThisClickOnceVersion" BeforeTargets="GenerateDeploymentManifest" Condition="'$(UpdateRequired)' == 'true' And '$(Install)' == 'true'">
		<PropertyGroup>
			<_DeploymentBuiltMinimumRequiredVersion>$(_DeploymentManifestVersion)</_DeploymentBuiltMinimumRequiredVersion>
		</PropertyGroup>
		<Message Importance="high" Text="ClickOnce minimum required version: $(_DeploymentBuiltMinimumRequiredVersion)" />
	</Target>

</Project>
